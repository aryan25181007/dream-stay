<% layout("/layouts/boilerplate") %>
<body>
    <h2 class="addnewheading">Update your listing</h3>
    <form action="/listings/<%= listing._id %>/edit?_method=PATCH" method="post">
         <div class="form-field">
                    <label for="fieldText" class="form-label">Name of the property</label>

                    <input name="title" type="text" class="form-control" id="fieldText" value="<%= listing.title %>">
                    <div class="form-text">
                        Edit the name your property
                    </div>
                </div>
                <div class="form-field">
                    <label for="fieldTextarea" class="form-label">Description</label>

                    <textarea name="description" class="form-control" id="fieldTextarea" rows="3"><%= listing.description %></textarea>
                    <div class="form-text">
                        Update description
                    </div>
                </div>
                <div class="form-field">
                    <label for="fieldText" class="form-label">Image</label>

                    <input name="image" type="text" class="form-control" id="fieldText"
                        value="<%= listing.image.url %>">
                    <div class="form-text">
                        Edit your image
                    </div>
                </div>
                <div class="row">
                    <div class="form-field col-4">
                        <label for="fieldText" class="form-label">Price</label>

                        <input name="price" type="number" class="form-control" id="fieldText" value="<%= listing.price %>">
                        <div class="form-text">
                            Update the price of the property / night.
                        </div>
                    </div>
                    <div class="form-field col-7">
                        <label for="fieldText" class="form-label">location</label>

                        <input name="location" type="text" class="form-control" id="fieldText" value="<%= listing.location %>">
                        <div class="form-text">
                            Update the city of your property.
                        </div>
                    </div>
                </div>
                <div class="form-field">
                    <label for="fieldText" class="form-label">Country</label>

                    <input name="country" type="text" class="form-control" id="fieldText" value="<%= listing.country %>">
                    <div class="form-text">
                        Update the Country.
                    </div>
                </div>
                <button type="submit" href="/listings" class="btn-outline theme-inverse addbut">Update Listing</button>
    </form>
</body>
